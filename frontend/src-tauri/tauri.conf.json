{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miyo",
  "version": "0.0.53",
  "identifier": "com.miyo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Miyo",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "devtools": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 15
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data: blob:; frame-src 'self' data: blob: about:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/miyo-mcp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/weihubeats/Miyo/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5NUU4NUY4NzNGOTkwNzkKUldSNWtQbHorSVZlR1RyZ0M0MmdIWTA3QW91S1NaWWRxamhReFZnaS9XdkplR2ErSWRUUGJheXAK"
    }
  }
}
