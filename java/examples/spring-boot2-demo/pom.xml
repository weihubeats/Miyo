<?xml version="1.0" encoding="UTF-8"?>
<!--
  Miyo 分类验收目标：Spring Boot 2.7 + Spring 5.3（与真实用户环境同版本线）。

  存在的意义：`spring-boot-demo` 是 Boot 3.2 / Spring 6，跑不出 Boot 2.x 的
  两个真实缺陷（上下文 getter 走代理、接口式 Bean + @Bean 返回类型）。这个模块
  必须保持 Boot 2.x，作为分类与 Bean 枚举的回归基线。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.redotpay</groupId>
  <artifactId>spring-boot2-demo</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>