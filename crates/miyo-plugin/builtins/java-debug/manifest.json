{
  "id": "com.miyo.java-debug",
  "name": "Java 方法调试",
  "name_key": "pnav.javaDebug",
  "description": "自动发现本机 Java 进程，用户确认后注入调试 Agent（零源码修改），浏览类 / Bean / 方法并受控调用；兼容 Runtime (SDK) 模式。",
  "description_key": "plugins.javaDebugDesc",
  "version": "0.1.0",
  "authors": ["Miyo"],
  "icon": "package",
  "kind": "ui",
  "min_app_version": "0.0.60",
  "sdk_version": 1,
  "nav": [
    {
      "id": "main",
      "label_key": "pnav.javaDebug",
      "icon": "package",
      "route": "/java-debug",
      "order": 40
    }
  ],
  "permissions": [
    "std.storage",
    "std.env.read",
    "std.notify",
    "std.log",
    "std.events",
    "java.process.discover",
    "java.runtime.attach",
    "java.class.inspect",
    "java.method.invoke"
  ],
  "runtime_deps": [
    {
      "kind": "java",
      "min_version": "11",
      "description": "Attach 模式需本机有完整 JDK（jdk.attach / tools.jar）；Runtime (SDK) 模式需目标应用内嵌 miyo-java-runtime"
    }
  ],
  "config_schema": {
    "properties": {
      "audit_log": {
        "type": "boolean",
        "title": "记录方法执行审计",
        "description": "每次方法执行在插件日志写入一条 audit 记录（不含参数原文）",
        "default": true
      }
    },
    "required": []
  }
}
